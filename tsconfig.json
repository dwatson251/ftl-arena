{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@ftl/sim": ["packages/sim/src/index.ts"],
      "@ftl/protocol": ["packages/protocol/src/index.ts"],
      "@ftl/data": ["packages/data/src/index.ts"],
      "@ftl/extract": ["packages/extract/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "apps/*/src", "tools/*", "packages/*/test"]
}
